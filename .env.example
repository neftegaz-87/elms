# Board projection (per-project; never commit real values in .env)
# Shared yaml: .loop/board-projection.yaml
LOOP_BOARD_PROVIDER=bitrix24

BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/USER/CODE/
BITRIX_GROUP_ID=26
BITRIX_RESPONSIBLE_ID=274
BITRIX_STAGE_BACKLOG=1342
BITRIX_STAGE_DESIGN=1343
BITRIX_STAGE_BUILD=1344
BITRIX_STAGE_VERIFY=1345
BITRIX_STAGE_UAT=1347
BITRIX_STAGE_DONE=1346
BITRIX_STAGE_BLOCKED=1347

# Plane (when LOOP_BOARD_PROVIDER=plane)
# PLANE_API_KEY=
# PLANE_BASE_URL=https://app.plane.so
# PLANE_WORKSPACE_SLUG=
# PLANE_PROJECT_ID=
# PLANE_STATE_BACKLOG=
# PLANE_STATE_DESIGN=
# PLANE_STATE_BUILD=
# PLANE_STATE_VERIFY=
# PLANE_STATE_UAT=
# PLANE_STATE_DONE=

PROJECT_DOCS_FOLDER=docs

# Per-epic Bitrix actor (creator+assignee): see .loop/board-actors.yaml
# Use: scripts/board-sync.sh <epic-id> | --all
