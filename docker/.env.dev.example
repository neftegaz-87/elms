KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_TEST_ONE_PASSWORD=
KEYCLOAK_TEST_TWO_PASSWORD=
KEYCLOAK_TEST_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_ID=elms-frappe
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_PUBLIC_HOST=elms-keycloak.localhost
KEYCLOAK_PUBLIC_URL=http://elms-keycloak.localhost:8480
KEYCLOAK_INTERNAL_URL=http://keycloak:8480
NEFTEGAZ_REVIEW_PUBLIC_URL=http://127.0.0.1:8765
NEFTEGAZ_REVIEW_CLIENT_SECRET=neftegaz-review-dev-secret-2026
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
