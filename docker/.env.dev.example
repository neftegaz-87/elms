COMPOSE_PROJECT_NAME=elms-dev

CUSTOM_IMAGE=elms
CUSTOM_TAG=dev
PULL_POLICY=never

SITE_NAME=elms.localhost
FRAPPE_SITE_NAME_HEADER=elms.localhost
SITE_HOST_NAME=http://elms.localhost:8082
