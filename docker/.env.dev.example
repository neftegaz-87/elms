COMPOSE_PROJECT_NAME=elms-dev

CUSTOM_IMAGE=elms
CUSTOM_TAG=dev
PULL_POLICY=never

SITE_NAME=elms.localhost
FRAPPE_SITE_NAME_HEADER=elms.localhost
SITE_HOST_NAME=http://elms.localhost:8082
FRAPPE_PUBLIC_URL=http://elms.localhost:8082

DB_PASSWORD=123
ADMIN_PASSWORD=admin

HTTP_PUBLISH_PORT=8082
NGINX_LISTEN_PORT=8080
DB_PUBLISH_PORT=3307

GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Keycloak and external IdP placeholders (T-B03)
KEYCLOAK_PUBLISH_PORT=8480
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_FALLBACK_PASSWORD=fallback123
KEYCLOAK_CLIENT_ID=elms-frappe
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_PUBLIC_URL=http://127.0.0.1:8480
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
ELMS_SSO_DEFAULT_ROLES=Desk User, ELMS LMS User
ELMS_SSO_REQUIRE=0
