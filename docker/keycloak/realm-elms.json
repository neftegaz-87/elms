{
  "id": "elms",
  "realm": "elms",
  "displayName": "ELMS",
  "displayNameHtml": "<b>ELMS</b>",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role"
      },
      {
        "name": "employee",
        "description": "Standard employee role"
      },
      {
        "name": "instructor",
        "description": "Instructor role"
      },
      {
        "name": "student",
        "description": "Student role"
      }
    ],
    "client": {
      "neftegaz-review": [
        {
          "name": "review_admin",
          "description": "Full access to the application review queue",
          "composite": false,
          "clientRole": true,
          "containerId": "neftegaz-review"
        },
        {
          "name": "review_dispatcher",
          "description": "Access to assigned review applications",
          "composite": false,
          "clientRole": true,
          "containerId": "neftegaz-review"
        },
        {
          "name": "review_queue_supervisor",
          "description": "Queue-wide access and assignment management",
          "composite": false,
          "clientRole": true,
          "containerId": "neftegaz-review"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "Administrators",
      "path": "/Administrators"
    },
    {
      "name": "Employees",
      "path": "/Employees"
    }
  ],
  "identityProviders": [
    {
      "alias": "yandex",
      "displayName": "Yandex 360",
      "providerId": "oidc",
      "enabled": true,
      "updateProfileFirstLoginMode": "on",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${env.YANDEX_CLIENT_ID:}",
        "clientSecret": "${env.YANDEX_CLIENT_SECRET:}",
        "authorizationUrl": "https://oauth.yandex.ru/authorize",
        "tokenUrl": "https://oauth.yandex.ru/token",
        "userInfoUrl": "https://login.yandex.ru/info",
        "defaultScope": "login:email login:info",
        "syncMode": "IMPORT",
        "validateSignature": "false",
        "useJwksUrl": "false"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "yandex-email-mapper",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "default_email",
        "user.attribute": "email"
      }
    },
    {
      "name": "yandex-first-name-mapper",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "first_name",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "yandex-last-name-mapper",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "last_name",
        "user.attribute": "lastName"
      }
    }
  ],
  "clients": [
    {
      "clientId": "elms-frappe",
      "name": "ELMS Frappe Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "secret": "${env.KEYCLOAK_CLIENT_SECRET:}",
      "rootUrl": "http://elms.localhost:8082",
      "baseUrl": "http://elms.localhost:8082",
      "redirectUris": [
        "http://elms.localhost:8082/api/method/frappe.integrations.oauth2_logins.login_via_keycloak",
        "http://elms.localhost/api/method/frappe.integrations.oauth2_logins.login_via_keycloak",
        "http://localhost:8082/api/method/frappe.integrations.oauth2_logins.login_via_keycloak",
        "http://127.0.0.1:8082/api/method/frappe.integrations.oauth2_logins.login_via_keycloak",
        "http://elms.localhost:8082/*",
        "http://localhost:8082/*",
        "http://127.0.0.1:8082/*"
      ],
      "webOrigins": [
        "http://elms.localhost:8082",
        "http://localhost:8082",
        "http://127.0.0.1:8082"
      ],
      "attributes": {
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "neftegaz-review",
      "name": "Neftegaz application review",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "${env.NEFTEGAZ_REVIEW_CLIENT_SECRET:}",
      "rootUrl": "__NEFTEGAZ_REVIEW_PUBLIC_URL__",
      "baseUrl": "__NEFTEGAZ_REVIEW_PUBLIC_URL__",
      "redirectUris": [
        "__NEFTEGAZ_REVIEW_PUBLIC_URL__/auth/callback"
      ],
      "webOrigins": [
        "__NEFTEGAZ_REVIEW_PUBLIC_URL__"
      ],
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "review-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "neftegaz-review",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "review_roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "bitrix-user-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "bitrix_user_id",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "bitrix_user_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "bitrix-member-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "bitrix_member_id",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "bitrix_member_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "bitrix-department-ids",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "bitrix_department_ids",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "bitrix_department_ids",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@elms.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Break-glass",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "${env.KEYCLOAK_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ],
      "clientRoles": {
        "neftegaz-review": [
          "review_admin"
        ]
      },
      "groups": [
        "/Administrators"
      ]
    },
    {
      "username": "elms.test.one@elms.local",
      "email": "elms.test.one@elms.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "ELMS Test",
      "lastName": "One",
      "credentials": [
        {
          "type": "password",
          "value": "${env.KEYCLOAK_TEST_ONE_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "employee"
      ],
      "clientRoles": {
        "neftegaz-review": [
          "review_dispatcher"
        ]
      },
      "groups": [
        "/Employees"
      ]
    },
    {
      "username": "elms.test.two@elms.local",
      "email": "elms.test.two@elms.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "ELMS Test",
      "lastName": "Two",
      "credentials": [
        {
          "type": "password",
          "value": "${env.KEYCLOAK_TEST_TWO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "employee"
      ],
      "clientRoles": {
        "neftegaz-review": [
          "review_queue_supervisor"
        ]
      },
      "groups": [
        "/Employees"
      ]
    },
    {
      "username": "elms.test.admin@elms.local",
      "email": "elms.test.admin@elms.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "ELMS Test",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "${env.KEYCLOAK_TEST_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ],
      "clientRoles": {
        "neftegaz-review": [
          "review_admin"
        ]
      },
      "groups": [
        "/Administrators"
      ]
    }
  ]
}
