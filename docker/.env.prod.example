# Production Compose contract for ELMS. Copy to docker/.env.prod and fill only
# non-secret deployment metadata. Runtime secrets come from HashiCorp Vault.
COMPOSE_PROJECT_NAME=elms-prod

# Immutable release identities. CI replaces these with the commit release.
CUSTOM_IMAGE=ghcr.io/replace-me/elms
CUSTOM_TAG=prod-REPLACE_WITH_COMMIT_SHA
CUSTOM_IMAGE_REF=
KEYCLOAK_IMAGE=ghcr.io/replace-me/elms-keycloak
KEYCLOAK_TAG=prod-REPLACE_WITH_COMMIT_SHA
KEYCLOAK_IMAGE_REF=
PULL_POLICY=always
RESTART_POLICY=unless-stopped
REQUIRE_IMAGE_DIGESTS=1

# Public hosts. DNS and the future edge cutover must be configured separately.
SITE_NAME=elms.example.com
AUTH_HOSTNAME=auth.example.com
FRAPPE_SITE_NAME_HEADER=elms.example.com
SITE_HOST_NAME=https://elms.example.com
KEYCLOAK_PUBLIC_URL=https://auth.example.com
FRAPPE_PUBLIC_URL=https://elms.example.com
NEFTEGAZ_REVIEW_PUBLIC_URL=https://review.example.com

# Staged pre-cutover listener. It binds localhost only.
ELMS_PROD_STAGE=0
STAGED_HTTP_PUBLISH_PORT=18080
STAGED_SITE_NAME=elms.localhost
STAGED_AUTH_HOSTNAME=auth.localhost
STAGED_SITE_HOST_NAME=http://elms.localhost:18080
STAGED_KEYCLOAK_PUBLIC_URL=http://auth.localhost:18080

# Public edge values are consumed only by docker/compose.prod.edge.yaml.
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443
NGINX_LISTEN_PORT=8080
ACME_EMAIL=admin@example.com

# Vault bootstrap file paths. These files are root-owned and live outside git.
VAULT_IMAGE=hashicorp/vault:1.18.4@sha256:790a848da73ea8260e982e79b1e320e899836a24bf059c1e8484d040623b6b93
VAULT_ROLE_ID_FILE=/etc/elms/vault/role-id
VAULT_SECRET_ID_FILE=/etc/elms/vault/secret-id

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
UPSTREAM_REAL_IP_ADDRESS=0.0.0.0/0
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=on
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# Keycloak and Frappe non-secret contract.
KEYCLOAK_ADMIN=admin
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_CLIENT_ID=elms-frappe
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
ELMS_SSO_DEFAULT_ROLES=Desk User, ELMS LMS User
ELMS_SSO_REQUIRE=1

# First-party review service integration. The review service owns its own runtime.
ELMS_REVIEW_URL=https://review.example.com/auth/login?source=elms&next=%2Fqueue
ELMS_REVIEW_ELMS_ROLES=ELMS Admin,ELMS Operations User,System Manager
ELMS_REVIEW_ROLE_MAP=ELMS Admin=admin,ELMS Operations User=dispatcher,System Manager=admin
ELMS_REVIEW_MEMBER_ID=elms-prod
ELMS_REVIEW_HANDOFF_TTL_SECONDS=60
ELMS_REVIEW_ALLOW_HTTP=0
