COMPOSE_PROJECT_NAME=elms-prod

CUSTOM_IMAGE=elms
CUSTOM_TAG=latest
PULL_POLICY=missing
RESTART_POLICY=unless-stopped

# Публичные хосты (DNS A/AAAA → IP сервера). Caddy сам получит Let's Encrypt.
SITE_NAME=elms.example.com
AUTH_HOSTNAME=auth.example.com
FRAPPE_SITE_NAME_HEADER=elms.example.com

# Публичные URL без портов — только HTTPS через Caddy
SITE_HOST_NAME=https://elms.example.com
KEYCLOAK_PUBLIC_URL=https://auth.example.com
FRAPPE_PUBLIC_URL=https://elms.example.com

# Единственные порты на хост: Caddy. Открой 80 и 443 на firewall.
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443
NGINX_LISTEN_PORT=8080

# ACME (Let's Encrypt) — обязателен рабочий email
ACME_EMAIL=admin@example.com

# Секреты: замени все значения перед первым up. Пустые/дефолтные — create-site упадёт.
DB_PASSWORD=
ADMIN_PASSWORD=

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

UPSTREAM_REAL_IP_ADDRESS=0.0.0.0/0
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=on
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# Keycloak (внутри сети, без publish на хост)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_FALLBACK_PASSWORD=
KEYCLOAK_CLIENT_ID=elms-frappe
KEYCLOAK_CLIENT_SECRET=

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

ELMS_SSO_DEFAULT_ROLES=Desk User, ELMS LMS User
ELMS_SSO_REQUIRE=1
